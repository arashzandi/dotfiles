# Database and Service Credentials
# Copy to .env.secrets and fill in real values: cp .env.secrets.example .env.secrets
# DO NOT COMMIT .env.secrets TO VERSION CONTROL (it's gitignored)
#
# This file is the canonical list of every var .zshrc expects. Run
# `secrets-drift` (defined in .zshrc) after adding/removing a var here
# or in .env.secrets to confirm they still match.

# Testing Environment
export TESTING_DB_URI=""
export TESTING_EXPORT_DB_URI=""
export TESTING_MONGO_URI=""

# Production Environment
export PRODUCTION_DB_URI=""
export PRODUCTION_EXPORT_DB_URI=""
export PRODUCTION_MONGO_URI=""
export PRODUCTION_BACKUP_MONGO_URI=""

# Demo Environment
export DEMO_DB_URI=""
export DEMO_EXPORT_DB_URI=""
export DEMO_MONGO_URI=""

# Development Environment
export DEVELOPMENT_DB_URI=""
export DEVELOPMENT_EXPORT_DB_URI=""
export DEVELOPMENT_MONGO_URI=""

export MIXPANEL_USERNAME=""
export MIXPANEL_SECRET=""

# Sentry
export SENTRY_AUTH_TOKEN=""

# Anthropic (kept commented out at the callsite in .zshrc; uncomment to use)
# export ANTHROPIC_API_KEY=""

# PayPal
export PAYPAL_CLIENTID=""
export PAYPAL_SECRET=""

# Sigma Computing API
export SIGMA_CLIENT_ID=""
export SIGMA_CLIENT_SECRET=""

# DBT
export DBT_PERSONAL_TOKEN=""
export DBT_PROD_OAUTH_CLIENT_SECRET_2=""
export DBT_PROD_OAUTH_CLIENT_SECRET=""
export DBT_PROD_OAUTH_CLIENT_ID=""

# BetterStack
export BETTERSTACK_UPTIME_TOKEN=""
export BETTERSTACK_TELEMETRY_TOKEN=""
